{
  "name": "voicescribe",
  "version": "1.1.0",
  "description": "VoiceScribe — Windows 11 için Akıllı ve Fluent Tasarımlı Sesli Dikte (Voice-to-Text) Uygulaması",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently -k \"vite\" \"cmd /c node python\\wait_for_vite.js && electron .\"",
    "start": "electron .",
    "prepare:python": "node python/prepare_python_runtime.js",
    "build:paste": "node python/build_paste.js",
    "dist:win": "node python/dist_win.js",
    "dist:win:unsigned": "set VOICESCRIBE_FORCE_UNSIGNED=1&& node python/dist_win.js"
  },
  "build": {
    "appId": "com.voicescribe.app",
    "productName": "VoiceScribe",
    "publish": {
      "provider": "github",
      "owner": "onderxyilmaz",
      "repo": "voice-scribe"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "python/**/*",
      "!python/prepare_python_runtime.js",
      "!python/package_nsis.js",
      "!python/stamp_icon.js",
      "!python/write_app_update_yml.js",
      "!python/clean_release_dir.js",
      "!python/wait_for_vite.js",
      "!python/build_paste.js",
      "!python/dist_win.js"
    ],
    "asarUnpack": [
      "electron/paste.exe",
      "electron/paste.ps1"
    ],
    "extraResources": [
      {
        "from": "python/local_whisper_engine.py",
        "to": "python/local_whisper_engine.py"
      },
      {
        "from": "python/analyze_audio.py",
        "to": "python/analyze_audio.py"
      },
      {
        "from": "python-runtime",
        "to": "python-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VoiceScribe",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico",
      "installerHeader": "electron/icon.png"
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "keywords": [
    "voicescribe",
    "dictation",
    "whisper",
    "voice-to-text",
    "windows11",
    "ai"
  ],
  "author": "Önder Yılmaz",
  "license": "MIT",
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2",
    "vite": "^6.1.0"
  }
}
